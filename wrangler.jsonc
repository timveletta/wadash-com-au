{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wadash-com-au",
  "main": "./worker/index.js",
  // Set this to today's date
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
